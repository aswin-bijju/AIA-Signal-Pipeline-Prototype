      "id": "9c86585d-082b-41c3-ba70-b0a166112e2a",
      "name": "Anthropic Model (Story Check)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        2720,
        1008
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"decisions\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"index\": {\"type\": \"integer\"},\n          \"status\": {\"type\": \"string\", \"enum\": [\"new\", \"repeat\", \"update\"]},\n          \"story_id\": {\"type\": \"string\"},\n          \"what_is_new\": {\"type\": \"string\"}\n        },\n        \"required\": [\"index\", \"status\"]\n      }\n    }\n  },\n  \"required\": [\"decisions\"]\n}"
      },
      "id": "61256d7a-7a89-4535-9035-cc32a1790e53",
      "name": "Story Check Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        2848,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "const events = $('Keep One Per Event').all().map(i => i.json);\nconst cutoff = Date.now() - 7 * 24 * 3600 * 1000;\nconst rows = $('Read Story Log').all().map(i => i.json)\n  .filter(r => r && r.story_id && new Date(r.seen_at).getTime() >= cutoff);\nconst known = {};\nconst urlToStory = {};\nfor (const r of rows) {\n  (known[r.story_id] = known[r.story_id] || []).push(r);\n  if (r.url) urlToStory[r.url] = r.story_id;\n}\n\nlet decisions = [];\ntry { decisions = $input.first().json.output.decisions || []; } catch (e) { decisions = []; }\nconst byIndex = {};\nfor (const d of decisions) {\n  const n = Number(d.index);\n  if (Number.isInteger(n) && !(n in byIndex)) byIndex[n] = d;\n}\n\nconst stamp = Date.now().toString(36);\nreturn events.map((e, i) => {\n  const d = byIndex[i] || {};\n  let status = ['new', 'repeat', 'update'].includes(d.status) ? d.status : 'new';\n  let storyId = d.story_id && known[d.story_id] ? d.story_id : null;\n  // Rule first: an article already logged this week is a repeat, whatever the model says\n  const seenUrl = [e.url, ...(e.also_reported || [])].find(u => urlToStory[u] && urlToStory[u] === urlToStory[e.url]) || (urlToStory[e.url] ? e.url : null);\n  if (seenUrl) { status = 'repeat'; storyId = urlToStory[seenUrl]; }\n  // Fail open: no decision or an unknown story id means the event is treated as new\n  if (status !== 'new' && !storyId) status = 'new';\n  const history = storyId ? known[storyId].sort((a, b) => new Date(a.seen_at) - new Date(b.seen_at)) : [];\n  return { json: {\n    ...e,\n    story_status: status,\n    story_id: storyId || `S-${stamp}-${i}`,\n    first_seen: history.length ? String(history[0].seen_at).slice(0, 10) : '',\n    previous_summary: history.slice(-4).map(r => String(r.seen_at).slice(0, 10) + ': ' + (r.what_is_new || r.summary)).join('\\n'),\n    what_is_new: status === 'update' ? String(d.what_is_new || '') : '',\n  } };\n});"
      },
