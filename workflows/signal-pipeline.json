    {
      "parameters": {
        "jsCode": "const signals = $('Not a Repeat?').all().map(i => i.json);\nconst rows = $input.all().map(i => i.json).filter(r => r && r.team);\n\nconst splitList = (s) => String(s || '').split(',').map(x => x.trim()).filter(Boolean);\nconst lower = (arr) => arr.map(x => String(x).trim().toLowerCase());\n\nconst out = [];\nfor (const s of signals) {\n  const sTopics = Array.isArray(s.topics) ? s.topics.map(String) : splitList(s.topics);\n  const sRegions = Array.isArray(s.regions) ? s.regions.map(String) : splitList(s.regions);\n  const urgency = Number(s.urgency) || 0;\n  const merged = Number(s.merged_count) || 0;\n  const mergedNote = merged > 0 ? ' (' + merged + ' similar report' + (merged > 1 ? 's' : '') + ' merged into this brief)' : '';\n  const storyNote = s.story_status === 'update' ? ' | UPDATE to a story first briefed ' + s.first_seen : '';\n  let matched = 0;\n\n  for (const r of rows) {\n    const rTopics = lower(splitList(r.topics));\n    const rRegions = lower(splitList(r.regions));\n    const minUrgency = (r.min_urgency === null || r.min_urgency === undefined || r.min_urgency === '') ? 1 : Number(r.min_urgency);\n    const topicHits = sTopics.filter(t => rTopics.includes(t.toLowerCase()));\n    const regionHits = sRegions.filter(g => rRegions.includes(g.toLowerCase()));\n\n    if (topicHits.length > 0 && regionHits.length > 0 && urgency >= minUrgency) {\n      matched++;\n      const reason = 'Matched topic ' + topicHits.join(', ') + ' and region ' + regionHits.join(', ') + '; urgency ' + urgency + ' meets threshold ' + minUrgency + mergedNote + storyNote;\n      out.push({ json: {\n        ...s,\n        routed: true,\n        team: r.team,\n        owner: r.owner || '',\n        channel: r.channel || '',\n        exposure_note: r.exposure_note || '',\n        min_urgency: minUrgency,\n        routing_reason: reason,\n      } });\n    }\n  }\n\n  if (matched === 0) {\n    out.push({ json: {\n      ...s,\n      routed: false,\n      team: '',\n      owner: '',\n      channel: '',\n      exposure_note: '',\n      min_urgency: null,\n      routing_reason: 'No org_map row matched topics [' + sTopics.join(', ') + '], regions [' + sRegions.join(', ') + '] at urgency ' + urgency + mergedNote + storyNote,\n    } });\n  }\n}\nreturn out;"
      },
