      "id": "5b2a53c6-4691-46c3-8b58-6b0b7d81dc7e",
      "name": "Read org_map",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1552,
        576
      ],
      "executeOnce": true,
      "alwaysOutputData": true
