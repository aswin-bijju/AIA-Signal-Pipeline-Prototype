      "id": "6922125c-493b-4e64-a2c5-1cf02cf091f6",
      "name": "Read Story Log",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        2272,
        800
      ],
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const events = $('Keep One Per Event').all().map(i => i.json);\nconst cutoff = Date.now() - 7 * 24 * 3600 * 1000;\nconst rows = $input.all().map(i => i.json)\n  .filter(r => r && r.story_id && new Date(r.seen_at).getTime() >= cutoff);\n\nconst byStory = {};\nfor (const r of rows) (byStory[r.story_id] = byStory[r.story_id] || []).push(r);\n\nconst stories = Object.entries(byStory).map(([id, rs]) => {\n  rs.sort((a, b) => new Date(a.seen_at) - new Date(b.seen_at));\n  const lines = rs.slice(-4).map(r => String(r.seen_at).slice(0, 10) + ': ' + (r.what_is_new || r.summary));\n  return { id, title: rs[rs.length - 1].title, lines };\n});\n\nconst eventList = events.map((e, i) => `[${i}] ${e.title} | ${e.one_line_summary}`).join('\\n');\nconst storyList = stories.length\n  ? stories.map(s => `{${s.id}} ${s.title}\\n  ` + s.lines.join('\\n  ')).join('\\n')\n  : '(none)';\n\nreturn [{ json: { event_count: events.length, story_count: stories.length, eventList, storyList } }];"
      },
      "id": "35abbd69-c832-4a82-9ab9-a082af7e5270",
      "name": "Bundle With History",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2496,
        800
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Today's events ({{ $json.event_count }}), numbered from 0:\n{{ $json.eventList }}\n\nStories the team was already told about in the last 7 days ({{ $json.story_count }}), with ids in braces:\n{{ $json.storyList }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You compare today's news events with stories a business team was already told about in the last 7 days. Return exactly one decision for every event index:\n- new: no matching story in the list.\n- repeat: matches a story and adds nothing the team would act on differently (same facts restated or re-reported by another outlet).\n- update: matches a story and adds material new facts (new incidents, numbers, decisions, dates, escalation or de-escalation).\nFor repeat and update, set story_id to the matching id exactly as written inside the braces. For update, set what_is_new to one sentence naming only the new facts, taken only from today's event text. For new, leave story_id and what_is_new empty. When unsure between repeat and update, choose update."
            }
          ]
        },
        "batching": {}
      },
