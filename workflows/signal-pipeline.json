    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-5-5"
        },
        "options": {}
      },
      "id": "4a5ca6ff-4fae-4c16-b994-a8a9cbbc2b3c",
      "name": "Anthropic Model (Grouping)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        1824,
        1008
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"groups\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"lead\": {\"type\": \"integer\"},\n          \"members\": {\"type\": \"array\", \"items\": {\"type\": \"integer\"}}\n        },\n        \"required\": [\"lead\", \"members\"]\n      }\n    }\n  },\n  \"required\": [\"groups\"]\n}"
      },
      "id": "659eb222-f712-4cbd-8495-4a1a62f86779",
      "name": "Grouping Schema",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1952,
        1008
      ]
    },
    {
      "parameters": {
        "jsCode": "const signals = $('Is Relevant?').all().map(i => i.json);\nlet groups = [];\ntry { groups = $input.first().json.output.groups || []; } catch (e) { groups = []; }\n\nconst used = new Set();\nconst out = [];\nconst uniq = (arr) => [...new Set(arr)];\nconst urg = (n) => Number(signals[n].urgency) || 0;\n\nfor (const g of groups) {\n  const members = uniq((g.members || []).map(Number))\n    .filter(n => Number.isInteger(n) && n >= 0 && n < signals.length && !used.has(n));\n  if (members.length === 0) continue;\n  // Lead = most urgent report in the group; the model's pick only breaks ties\n  const maxUrg = Math.max(...members.map(urg));\n  const top = members.filter(n => urg(n) === maxUrg);\n  const modelLead = Number(g.lead);\n  const lead = top.includes(modelLead) ? modelLead : top[0];\n  members.forEach(n => used.add(n));\n  const others = members.filter(n => n !== lead).map(n => signals[n]);\n  out.push({ json: {\n    ...signals[lead],\n    topics: uniq(members.flatMap(n => signals[n].topics || [])).filter(t => t !== 'none'),\n    regions: uniq(members.flatMap(n => signals[n].regions || [])),\n    urgency: maxUrg,\n    merged_count: others.length,\n    also_reported: others.map(o => o.url),\n  } });\n}\n\n// Fail open: anything the grouping step missed is still sent on its own\nsignals.forEach((s, i) => {\n  if (!used.has(i)) out.push({ json: { ...s, merged_count: 0, also_reported: [] } });\n});\n\nreturn out;"
      },
      "id": "e792f00c-aaed-474d-a565-bc0bd45d2d9d",
      "name": "Keep One Per Event",
      "type": "n8n-nodes-base.code",
