      "id": "c9190183-af49-42cd-9290-4177434e3019",
      "name": "Bundle Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        800
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=There are {{ $json.count }} news items, numbered from 0:\n\n{{ $json.list }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You group news items so a business team is not sent the same story twice in one batch. Put items in the same group when a second brief would not change what the team does: the same incident, or new developments in the same ongoing situation affecting the same place or trade route (for example several reports on attacks in the same strait). Items about different places, routes or decisions stay in separate groups. Every index must appear in exactly one group, including items that stand alone. For each group, set lead to the index of the item with the most concrete facts. Use only indices from the list."
            }
          ]
        },
        "batching": {}
      },
      "id": "8957baae-675c-425b-a4da-70d9ee4b5195",
      "name": "Group Same Events",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
