    {
      "parameters": {
        "promptType": "define",
        "text": "=Team: {{ $json.team }}\nExposure note: {{ $json.exposure_note }}\nRouting reason: {{ $json.routing_reason }}\nStory status: {{ $json.story_status }}\n{{ $json.story_status === 'update' ? 'Earlier coverage of this story in the last 7 days:\\n' + $json.previous_summary + '\\nNew facts flagged by the comparison step: ' + $json.what_is_new + '\\n' : '' }}\nTitle: {{ $json.title }}\nURL: {{ $json.url }}\nOne-line summary: {{ $json.one_line_summary }}\n\nSource text:\n{{ $json.summary }}",
        "messages": {
          "messageValues": [
            {
              "message": "Write a brief of 80 to 120 words for the named team. It will be posted in Slack, so format for Slack: use single asterisks for bold labels (*like this*), never double asterisks, no # headings, no markdown links.\n\nUse only facts present in the source text. Structure, one short paragraph each:\n*What happened:* 1 sentence.\n*Why it reaches you:* use the exposure note in plain words. Do not repeat the routing reason.\n*What it could change (assessment, not fact):* 1 to 2 sentences.\n*Check next:* 1 action.\n\nIf Story status is update, the team was already briefed on this story in the last 7 days. Use this structure instead:\n*Update:* only what is new, 1 to 2 sentences, taken from the source text. Ignore any flagged new fact the source text does not support.\n*Last week:* 1 sentence recap, drawn only from the earlier coverage lines.\n*What it could change (assessment, not fact):* 1 sentence.\n*Check next:* 1 action.\n\nDo not include the source link; it is added separately. Do not add a title line. If the source does not support a claim, leave it out."
            }
          ]
        },
        "batching": {}
      },
